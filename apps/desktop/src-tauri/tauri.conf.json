{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModelShelf",
  "version": "0.1.0",
  "identifier": "io.modelshelf.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ModelShelf",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Your AI Models. One Place.",
    "category": "DeveloperTool",
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
